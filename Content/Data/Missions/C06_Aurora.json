	"on_start": [
		{ "type": "dialogue", "lines": [
			{ "speaker": "Gen. Adrian Hale", "color": [0.95, 0.8, 0.45], "text": "I'm coming with you this time, Commander. Keep me out of the line of fire and I'll keep out of your way." },
			{ "speaker": "Dr. Ilse Varga (radio)", "color": [0.85, 0.85, 1.0], "text": "The four power plants around the Lance feed its Arc Towers. Take them out first if you can." }
		] }
	],

	"triggers": [
		{ "id": "strike1", "when": { "type": "time", "seconds": 420 }, "actions": [
			{ "type": "dialogue", "lines": [ { "speaker": "Lt. Sarah Okafor", "color": [0.4, 0.75, 1.0], "text": "Power surge on Belov! The Lance is test-firing - get clear of the base!" } ] },
