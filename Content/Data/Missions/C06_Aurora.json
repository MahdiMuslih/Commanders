			{ "type": "dialogue", "lines": [ { "speaker": "Gen. Adrian Hale", "color": [0.95, 0.8, 0.45], "text": "Five minutes to midnight, Commander. Everything we have - throw it at that Lance now!" } ] }
		] },
		{ "id": "power_down", "when": { "type": "destroyed", "tag": "LancePower" }, "actions": [
			{ "type": "dialogue", "lines": [ { "speaker": "Dr. Ilse Varga (radio)", "color": [0.85, 0.85, 1.0], "text": "The ring is down! Its Arc Towers are blind. Now - strike the Lance!" } ] }
		] },
		{ "id": "approach", "when": { "type": "area", "team": "player", "area": [56, 0, 24, 24] }, "actions": [
			{ "type": "dialogue", "lines": [ { "speaker": "Col. Gregor Strel", "color": [0.75, 0.75, 0.8], "text": "Concord dogs on the mountain. Aurora Guard - no one leaves Belov alive." } ] }
		] },
		{ "id": "counter", "when": { "type": "time", "seconds": 720 }, "actions": [
